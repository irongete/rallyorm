# Configuration file for local development and live validation.
# Copy this file to .env and fill in the values you actually need.
# Do not commit .env with real credentials.

# ─── Library / runtime ────────────────────────────────────────────────────────
# These variables are read by RallyClient when you use the library in your own
# application code (src/core/rally-client.ts). None of them are required by the
# test suite itself.

# Required. Rally API key.
# Get it from Rally: User Profile > API Keys.
RALLY_API_KEY=

# Optional. Rally workspace ObjectID.
# If omitted, Rally uses the default workspace for the API key.
RALLY_WORKSPACE=

# Optional. Rally WSAPI base URL.
# Default: https://rally1.rallydev.com/slm/webservice/v2.0
RALLY_BASE_URL=

# Optional. Log level for RallyClient output.
# Accepted values: silent, error, warn, info, debug
RALLY_LOG_LEVEL=

# Optional. Global request concurrency limit.
# Default: 10
RALLY_MAX_CONCURRENT_REQUESTS=

# Optional. Set to true to block all mutating operations regardless of the
# allowCreate / allowUpdate / allowDelete constructor options.
RALLY_READ_ONLY=

# Optional. Convenience flag to enable all three write operations at once.
# Equivalent to setting allowCreate + allowUpdate + allowDelete to true.
RALLY_ALLOW_WRITE=

# Optional. Individually enable create, update, or delete operations.
# Each defaults to false when not set. RALLY_ALLOW_WRITE overrides all three.
RALLY_ALLOW_CREATE=
RALLY_ALLOW_UPDATE=
RALLY_ALLOW_DELETE=

# ─── Integration test suite ───────────────────────────────────────────────────
# These variables are only needed to run the live integration tests
# (npm run test:live / npm run release:check:publish).
# The library itself never reads them.

# Required to enable the live suite. Set to 1 or true to opt in.
RALLY_INTEGRATION=

# Required for live tests. ObjectID of a writable Rally project used as the
# test fixture target.
RALLY_TEST_PROJECT_OID=

# Optional. OIDs of existing Rally artifacts used as read fixtures.
RALLY_TEST_USERSTORY_OID=
RALLY_TEST_TESTCASE_OID=