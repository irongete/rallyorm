# Configuration file for environment variables
# Copy this file as .env and configure your values

# Rally API Key (REQUIRED for integration tests with real API)
# Get your API Key from: https://rally1.rallydev.com/login
# Then go to: User Profile > API Keys
RALLY_API_KEY=

# Rally Workspace (OPTIONAL - if not specified, the default workspace will be used)
# You must provide the workspace ID (numeric), NOT the visible name.
# Example: if your Rally URL is https://rally1.rallydev.com/#/workspace/12345
# then the workspace ID is 12345
RALLY_WORKSPACE=