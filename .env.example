# Configuration file for local development and live validation.
# Copy this file to .env and fill in the values you actually need.
# Do not commit .env with real credentials.

# Enables the live Rally integration suite.
# Use 1 or true to enable.
RALLY_INTEGRATION=

# Rally API key used by the live integration suite.
# Get it from Rally: User Profile > API Keys.
RALLY_API_KEY=

# Optional Rally workspace ObjectID.
# If omitted, Rally uses the default workspace for the API key.
RALLY_WORKSPACE=

# Optional Rally WSAPI base URL.
# Default in code: https://rally1.rallydev.com/slm/webservice/v2.0
RALLY_BASE_URL=

# Optional log level for live integration runs.
# Supported values: silent, error, warn, info, debug
RALLY_LOG_LEVEL=

# Optional global request concurrency limit for Rally API calls.
# Default in code: 10
RALLY_MAX_CONCURRENT_REQUESTS=

# Required for live write validation.
# This should be a writable Rally project ObjectID used by the test suite.
RALLY_TEST_PROJECT_OID=

# Optional live fixture IDs for targeted integration scenarios.
RALLY_TEST_USERSTORY_OID=
RALLY_TEST_TESTCASE_OID=